@model bt33.Models.Product

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<h4>Product</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Id)</dt>
    <dd class="col-sm-10">@Model.Id</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Price)</dt>
    <dd class="col-sm-10">@Model.Price.ToString("N0") đ</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Description)</dt>
    <dd class="col-sm-10">@Model.Description</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CategoryId)</dt>
    <dd class="col-sm-10">@(Model.Category?.Name ?? "(không có)")</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
